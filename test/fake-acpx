#!/usr/bin/env node
// Fake acpx for the resource-agent tests: answers without an agent or a model.
// Every call (arguments and relevant environment variables) is appended to $FAKE_ACPX_DIR/calls.jsonl,
// conversation records are kept in $FAKE_ACPX_DIR/records/.
// A question containing SLOW is answered after $FAKE_ACPX_SLOW_MS ms (2000 by default) unless the cancel
// command comes first; a question containing DENIED exits with code 5, like a permission denial.
// The text of every question is appended to $FAKE_ACPX_DIR/prompts.jsonl. The answer repeats the question
// without the answer rules resource-agent puts before the first question of a conversation.
// $FAKE_ACPX_AGENT_EXIT makes the agent command fail to start with that code (69: a full agent server) when
// a conversation is created or a question is asked, the way acpx reports it: its own code 1, the agent's in the text.
// $FAKE_ACPX_HISTORY_BYTES adds a message history of that size to the sessions show output,
// like the real acpx, which prints the whole conversation record.
// Like OpenCode, a model has the "effort" setting with the levels low, medium, high and default, and a new
// conversation starts with low; a model with "plain" in its name has no levels, as a model without variants.
// The mode is the "mode" setting with plan and build. An agent command with "claude" in it has Claude Code's modes
// default, acceptEdits and plan and the level setting "thinking" (ACP category thought_level); with "modeless" in it
// the agent has no mode setting and takes a mode only through set-mode, like an agent without config options.
"use strict";

const crypto = require("node:crypto");
const fs = require("node:fs");
const path = require("node:path");

const dir = process.env.FAKE_ACPX_DIR;
const args = process.argv.slice(2);
const logged = ["OPENCODE_CONFIG_CONTENT", "OPENCODE_DISABLE_AUTOUPDATE", "RESOURCE_AGENT_CHAT", "RESOURCE_AGENT_SESSION", "OPENCODE_SESSION_ID", "OPENCODE_PERMISSION", "FAKE_AGENT_VAR"];
fs.mkdirSync(path.join(dir, "records"), { recursive: true });
fs.appendFileSync(
  path.join(dir, "calls.jsonl"),
  `${JSON.stringify({ args, env: Object.fromEntries(logged.map((name) => [name, process.env[name]])) })}\n`,
);

if (args[0] === "--version") {
  console.log("0.19.4-fake");
  process.exit(0);
}

const withValue = new Set(["--cwd", "--agent", "--format", "--timeout", "--ttl", "--model"]);
const options = {};
let i = 0;
while (i < args.length && args[i].startsWith("--")) {
  if (withValue.has(args[i])) {
    options[args[i].slice(2)] = args[i + 1];
    i += 2;
  } else {
    options[args[i].slice(2)] = true;
    i += 1;
  }
}
const [command, ...rest] = args.slice(i);
const flag = (name) => {
  const at = rest.indexOf(name);
  return at === -1 ? undefined : rest[at + 1];
};
const safe = (name) => name.replace(/[^A-Za-z0-9_.-]/g, "_");
const recordFile = (name) => path.join(dir, "records", `${safe(name)}.json`);
const cancelFile = (name) => path.join(dir, `cancel-${safe(name)}`);
const readRecord = (name) => (fs.existsSync(recordFile(name)) ? JSON.parse(fs.readFileSync(recordFile(name), "utf8")) : undefined);
const writeRecord = (record) => fs.writeFileSync(recordFile(record.name), JSON.stringify(record));
const agent = options.agent ?? "";
const select = (id, category, currentValue, values) => ({ id, category, type: "select", currentValue, options: values.map((value) => ({ value, name: value })) });
const effortOption = (model) =>
  model.includes("plain") ? [] : [select(agent.includes("claude") ? "thinking" : "effort", "thought_level", "low", ["low", "medium", "high", "default"])];
const modeOption = () => {
  if (agent.includes("modeless")) return [];
  return [agent.includes("claude") ? select("mode", "mode", "default", ["default", "acceptEdits", "plan"]) : select("mode", "mode", "build", ["plan", "build"])];
};
const configOptions = (model) => [...modeOption(), ...effortOption(model)];
const noSession = (name) => {
  process.stderr.write(`[acpx] error: NO_SESSION ${name}\n`);
  process.exit(4);
};

const agentExit = process.env.FAKE_ACPX_AGENT_EXIT;
const startupFailure = `ACP agent exited before initialize completed (exit=${agentExit}, signal=null): the agent server is full`;
if (agentExit && command === "sessions" && ["ensure", "new"].includes(rest[0])) {
  console.log(JSON.stringify({ error: { message: startupFailure } }));
  process.exit(1);
}
if (agentExit && command === "prompt") {
  process.stderr.write(`[acpx] error: RUNTIME AGENT_STARTUP_FAILED ${startupFailure}\n`);
  process.exit(1);
}

// $FAKE_ACPX_PREP_TIMEOUT: creating a conversation does not finish in time, like a slow first start of an agent.
if (process.env.FAKE_ACPX_PREP_TIMEOUT && command === "sessions" && ["ensure", "new"].includes(rest[0])) {
  console.log(JSON.stringify({ error: { message: "Timed out after 120000ms" } }));
  process.exit(3);
}

if (command === "sessions") {
  const [sub, maybeName] = rest;
  if (sub === "show") {
    const record = readRecord(maybeName);
    if (!record) noSession(maybeName);
    const history = Number(process.env.FAKE_ACPX_HISTORY_BYTES ?? 0);
    process.stdout.write(`${JSON.stringify({ ...record, messages: history ? ["x".repeat(history)] : [] })}\n`);
  } else if (sub === "ensure" || sub === "new") {
    const name = flag("--name");
    const existing = readRecord(name);
    if (sub === "ensure" && existing && !existing.closed) {
      console.log(JSON.stringify({ action: "session_ensured", created: false, name }));
    } else {
      writeRecord({
        acpxRecordId: crypto.randomUUID(),
        name,
        closed: false,
        acpx: {
          desired_config_options: {},
          current_model_id: options.model ?? "fake/default",
          config_options: configOptions(options.model ?? "fake/default"),
        },
      });
      console.log(JSON.stringify({ action: "session_ensured", created: true, name }));
    }
  } else {
    process.stderr.write(`fake-acpx: sessions ${sub} is not supported\n`);
    process.exit(2);
  }
} else if (command === "set") {
  const [key, value] = rest;
  const name = flag("-s");
  const record = readRecord(name);
  if (!record) noSession(name);
  if (key === "model") {
    record.acpx.current_model_id = value;
    const levels = record.acpx.config_options.filter((entry) => entry.category === "thought_level");
    record.acpx.config_options = [...record.acpx.config_options.filter((entry) => entry.category !== "thought_level"), ...effortOption(value)];
    for (const entry of levels) if (!effortOption(value).length) delete record.acpx.desired_config_options[entry.id];
  } else {
    const option = record.acpx.config_options.find((entry) => entry.id === key);
    if (!option) {
      console.log(JSON.stringify({ error: { message: `Unknown config option: ${key}` } }));
      process.exit(1);
    }
    option.currentValue = value;
    record.acpx.desired_config_options[key] = value;
  }
  writeRecord(record);
  console.log(JSON.stringify({ action: "config_set", configId: key, value }));
} else if (command === "set-mode") {
  const [mode] = rest;
  const name = flag("-s");
  const record = readRecord(name);
  if (!record) noSession(name);
  record.acpx.desired_mode_id = mode;
  record.acpx.current_mode_id = mode;
  writeRecord(record);
  console.log(JSON.stringify({ action: "mode_set", modeId: mode }));
} else if (command === "cancel") {
  fs.writeFileSync(cancelFile(flag("-s")), "");
  console.log(JSON.stringify({ action: "cancel_requested" }));
} else if (command === "prompt") {
  const name = flag("-s");
  if (!readRecord(name)) noSession(name);
  const prompt = fs.readFileSync(flag("-f"), "utf8");
  fs.appendFileSync(path.join(dir, "prompts.jsonl"), `${JSON.stringify({ session: name, prompt })}\n`);
  const marker = "\nQuestion:\n";
  const question = prompt.includes(marker) ? prompt.slice(prompt.indexOf(marker) + marker.length) : prompt;
  const finish = () => {
    if (question.includes("DENIED")) {
      process.stderr.write("[acpx] error: permission denied\n");
      process.exit(5);
    }
    console.log(`answer: ${question.trim()}`);
    process.stderr.write("[acpx] tokens: input=1 output=1\n");
    process.exit(0);
  };
  process.on("SIGINT", () => process.exit(130));
  if (!question.includes("SLOW")) finish();
  else {
    const deadline = Date.now() + Number(process.env.FAKE_ACPX_SLOW_MS ?? 2000);
    const timer = setInterval(() => {
      if (fs.existsSync(cancelFile(name))) {
        fs.rmSync(cancelFile(name));
        process.stderr.write("[acpx] error: cancelled\n");
        process.exit(130);
      }
      if (Date.now() >= deadline) {
        clearInterval(timer);
        finish();
      }
    }, 100);
  }
} else {
  process.stderr.write(`fake-acpx: command ${command} is not supported\n`);
  process.exit(2);
}
